# ── C-GPT Backend Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Ollama endpoint. Set to wherever Ollama is running.
#
# Option A — Ollama running on the same machine (native Windows or Linux):
OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Option B — Ollama on Windows host, FastAPI running inside WSL:
#   Find gateway IP inside WSL: ip route show default | awk '{print $3}'
#   OLLAMA_BASE_URL=http://<WSL_GATEWAY_IP>:11434
#
# Option C — Ollama on a remote server via SSH tunnel:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434   (tunnel maps remote:11434 → local:11434)

# Active generation model — must already be pulled in Ollama.
# Check installed models: ollama list
DEFAULT_MODEL=qwen2.5-coder:7b

# Optional: override default paths
# DB_PATH=data/institutional.db
# CHROMA_DIR=data/chroma
# EMBED_MODEL=all-MiniLM-L6-v2
